//Conta vocali stringa
#include <stdio.h>
#include <string.h>
#define MAX 100
int contaVocali(char *stringa);

int main() {
    char stringa[MAX];
    int numVoc;
    printf("Inserire una stringa (max %d caratteri):\n", MAX);
    fgets(stringa, MAX, stdin);
    stringa[strcspn(stringa, "\n")]='\0';
    numVoc=contaVocali(stringa);
    printf("Numero Vocali: %d", numVoc);
    return 0;
}

int contaVocali(char *stringa) {
    int num=0;
    for(int i=0; i<strlen(stringa); i++) {
            switch(*(stringa+i)) {
                case 'A': case 'a': case 'E': case 'e': case 'I': case 'i': case 'O': case 'o': case 'U': case 'u': num++; break;
                default: break;
                }
        }
    return num;
}
